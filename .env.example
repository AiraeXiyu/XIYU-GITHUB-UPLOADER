# Create an OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local: http://localhost:3000/api/auth/github/callback
# Production: https://YOUR-DOMAIN.vercel.app/api/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# Generate with: openssl rand -base64 32
SESSION_PASSWORD=replace-with-at-least-32-characters-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
